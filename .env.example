PROXY_FILE=proxies
PROXY_ENABLED=false
PROXY_ALLOW_DIRECT_FALLBACK=false
COLLECTOR_CONCURRENCY=4
COLLECTOR_LOG_RECORDS=false
COLLECTOR_LOG_RESULTS=false
MAX_REQUESTS_PER_MINUTE=100
MAX_REQUESTS_PER_MINUTE_PER_PROXY=10
MAX_CONCURRENT_REQUESTS_PER_PROXY=1
PROXY_FAILURE_THRESHOLD=3
PROXY_COOLDOWN_SECONDS=120
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
COLLECTOR_TIMEZONE=Europe/Lisbon
COLLECTOR_SCHEDULE_HOURS=6,18
COLLECTOR_FAILURE_RETRY_SECONDS=900
F1_SETUP_LAPS_URL=https://example.com/setups
EA_SETUP_URL=https://example.com/ea-setups
# Local MongoDB used by tests when TEST_MONGODB_ENV=sandbox.
MONGODB_SANDBOX_URI=mongodb://localhost:27017
# Production server used by main.py. Add credentials to the URI when required.
MONGODB_PRODUCTION_URI=mongodb://user:pass@192.168.1.176:27017
MONGODB_DATABASE=collector
MONGODB_COLLECTION=setups
# Tests may use sandbox or production. Keep sandbox as the safe default.
TEST_MONGODB_ENV=sandbox
METRICS_ENABLED=true
METRICS_BIND_ADDRESS=0.0.0.0
COLLECTOR_METRICS_PORT=9102
