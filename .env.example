PROXY_URL=http://user:password@host:port
REQUESTS_PER_MINUTE=30
REQUEST_TIMEOUT_SECONDS=30
F1_SETUP_LAPS_URL=https://example.com/setups
EA_SETUP_URL=https://example.com/ea-setups
# Local MongoDB used by tests when TEST_MONGODB_ENV=sandbox.
MONGODB_SANDBOX_URI=mongodb://localhost:27017
# Production server used by main.py. Add credentials to the URI when required.
MONGODB_PRODUCTION_URI=mongodb://username:password@SERVER_IP:27017
MONGODB_DATABASE=collector
MONGODB_COLLECTION=F1
# Tests may use sandbox or production. Keep sandbox as the safe default.
TEST_MONGODB_ENV=sandbox
